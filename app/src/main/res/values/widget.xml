<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="widget_continue">Continue</string>
    <string name="widget_description">Where you stopped in anime, manga and light novels, and recommendations. Swipe a column up for the next one.</string>
    <string name="widget_anime">Anime</string>
    <string name="widget_manga">Manga</string>
    <string name="widget_novels">Light novel</string>
    <string name="widget_recommendations">For you</string>
    <string name="widget_empty_anime">Nothing watched yet</string>
    <string name="widget_empty_manga">Nothing read yet</string>
    <string name="widget_empty_novels">No light novel read yet</string>
    <string name="widget_empty_recommendations">Recommendations show up after the next check</string>

    <!-- The column's name, drawn by the widget in the app look's own lettering. -->
    <style name="WidgetHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- The widget picker's still picture keeps plain text. -->
    <style name="WidgetPreviewHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/widget_header_pill</item>
        <item name="android:paddingHorizontal">9dp</item>
        <item name="android:paddingVertical">2dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetEmpty">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="WidgetCover">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- A card's title and detail, drawn as one picture so they can use the look's fonts. -->
    <style name="WidgetTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>

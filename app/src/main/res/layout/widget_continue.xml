<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="NestedWeights,SmallSp">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_anime"
                style="@style/WidgetHeader"
                android:text="@string/widget_anime" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <StackView
                    android:id="@+id/stack_anime"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:loopViews="true" />

                <TextView
                    android:id="@+id/empty_anime"
                    style="@style/WidgetEmpty"
                    android:text="@string/widget_empty_anime" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_manga"
                style="@style/WidgetHeader"
                android:text="@string/widget_manga" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <StackView
                    android:id="@+id/stack_manga"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:loopViews="true" />

                <TextView
                    android:id="@+id/empty_manga"
                    style="@style/WidgetEmpty"
                    android:text="@string/widget_empty_manga" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_novels"
                style="@style/WidgetHeader"
                android:text="@string/widget_novels" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <StackView
                    android:id="@+id/stack_novels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:loopViews="true" />

                <TextView
                    android:id="@+id/empty_novels"
                    style="@style/WidgetEmpty"
                    android:text="@string/widget_empty_novels" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_recommendations"
                style="@style/WidgetHeader"
                android:text="@string/widget_recommendations" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <StackView
                    android:id="@+id/stack_recommendations"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:loopViews="true" />

                <TextView
                    android:id="@+id/empty_recommendations"
                    style="@style/WidgetEmpty"
                    android:text="@string/widget_empty_recommendations" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

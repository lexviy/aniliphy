<?xml version="1.0" encoding="utf-8"?>
<!-- Four columns, each with the latest title of its kind. Tapping a column's name opens the wheel with all of them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription,NestedWeights,SmallSp,UselessParent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/header_anime"
                style="@style/WidgetHeader"
                android:contentDescription="@string/widget_anime" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/card_anime"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/cover_anime"
                        style="@style/WidgetCover" />

                    <ImageView
                        android:id="@+id/title_anime"
                        style="@style/WidgetTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/empty_anime"
                    style="@style/WidgetEmpty"
                    android:text="@string/widget_empty_anime" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/header_manga"
                style="@style/WidgetHeader"
                android:contentDescription="@string/widget_manga" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/card_manga"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/cover_manga"
                        style="@style/WidgetCover" />

                    <ImageView
                        android:id="@+id/title_manga"
                        style="@style/WidgetTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/empty_manga"
                    style="@style/WidgetEmpty"
                    android:text="@string/widget_empty_manga" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/header_novels"
                style="@style/WidgetHeader"
                android:contentDescription="@string/widget_novels" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/card_novels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/cover_novels"
                        style="@style/WidgetCover" />

                    <ImageView
                        android:id="@+id/title_novels"
                        style="@style/WidgetTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/empty_novels"
                    style="@style/WidgetEmpty"
                    android:text="@string/widget_empty_novels" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/header_recommendations"
                style="@style/WidgetHeader"
                android:contentDescription="@string/widget_recommendations" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/card_recommendations"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/cover_recommendations"
                        style="@style/WidgetCover" />

                    <ImageView
                        android:id="@+id/title_recommendations"
                        style="@style/WidgetTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/empty_recommendations"
                    style="@style/WidgetEmpty"
                    android:text="@string/widget_empty_recommendations" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- The look's small motion in the corner: two frames taking turns (hidden when Look animations are off). -->
    <ViewFlipper
        android:id="@+id/widget_motif"
        android:layout_width="48dp"
        android:layout_height="8dp"
        android:layout_gravity="bottom|end"
        android:autoStart="true"
        android:flipInterval="900"
        android:importantForAccessibility="no"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <ImageView
            android:id="@+id/widget_motif_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/widget_motif_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </ViewFlipper>
</FrameLayout>
